<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Meri Website</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f2f2f2;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    header {
      background-color: #007bff;
      color: white;
      width: 100%;
      padding: 20px;
      text-align: center;
    }

    .content {
      margin-top: 30px;
      text-align: center;
    }

    .content img {
      max-width: 90%;
      height: auto;
      border-radius: 10px;
    }

    .btn {
      margin-top: 20px;
      padding: 12px 25px;
      background-color: #28a745;
      color: white;
      text-decoration: none;
      font-size: 18px;
      border-radius: 5px;
      display: inline-block;
      transition: background 0.3s;
    }

    .btn:hover {
      background-color: #218838;
    }

    footer {
      margin-top: 40px;
      padding: 10px;
      text-align: center;
      color: #666;
    }
  </style>
</head>
<body>

  <header>
    <h1>मेरी पहली वेबसाइट</h1>
  </header>

  <div class="content">
    <img src="https://via.placeholder.com/600x300" alt="Demo Image">
    <br>
    <a href="https://example.com" target="_blank" class="btn">Visit Example</a>
  </div>

  <footer>
    © 2025 Meri Website. All rights reserved.
  </footer>

</body>
</html>
